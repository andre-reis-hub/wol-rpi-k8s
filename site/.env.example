# .env do painel wol-panel — copie para .env e preencha.
# NAO commitar o .env real (esta no .gitignore). Guarde os valores no Bitwarden.

# --- Login do painel (voce define) ---
SECRET_KEY=            # gere: python3 -c "import secrets; print(secrets.token_hex(32))"
USERNAME=admin
PASSWORD=              # senha admin do painel (ex: a que voce usava)
GUEST_USERNAME=convidado
GUEST_PASSWORD=        # senha do convidado (opcional)

# --- Rede / i9 ---
PC_LOCAL_IP=192.168.15.14
PC_MAC=                # MAC da placa CABEADA do i9. No i9: ip link (interface UP, ex enp5s0)
PC_SSH_USER=andre-reis

# --- Kubernetes (do i9) ---
K8S_API=https://192.168.15.14:6443
K8S_TOKEN=             # no i9: kubectl create token panel-controller -n kube-system --duration=8760h
K8S_CA_CERT=           # DEIXAR VAZIO (painel conecta sem validar cert na LAN — ver app.py _k8s_verify)

# --- Loki (logs, do i9) ---
LOKI_URL=http://192.168.15.14:31100
LOKI_WINDOW_HOURS=12

# --- Palworld REST API (do i9) ---
PALWORLD_API_URL=http://192.168.15.14:30212   # porta 8212->30212/TCP: kubectl get svc -n palworld
PALWORLD_API_USER=admin
PALWORLD_API_PASS=     # no i9: kubectl get secret palworld-secrets -n palworld -o jsonpath='{.data.admin-password}' | base64 -d

# --- Links (defaults ja bons) ---
GRAFANA_BASE=https://grafana.areis-solution.com
ARGOCD_BASE=https://argocd.areis-solution.com
AUTO_PUBLIC_IP=true
CHAT_LIMIT=10

# --- Opcionais ---
# REGISTER_TOKEN=      # se o agente do i9 registra IP/servicos; precisa bater com o agente
# TUNNEL_URL=          # url do tunel cloudflare, se quiser exibir no painel
# PUBLIC_HOST=         # forca um host publico fixo (senao AUTO_PUBLIC_IP descobre)
